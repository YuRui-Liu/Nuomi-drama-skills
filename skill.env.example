# .claude/skills/nuomi-drama-skills/skill.env.example
# 复制此文件为 skill.env 并填入真实凭据（skill.env 不应提交到 git）

# ── 图片 Provider 路由 ──────────────────────────────────
IMAGE_PROVIDER=grsai          # grsai | comfyui | runninghub | gemini

# ── Gemini ───────────────────────────────────────────────
GEMINI_API_KEY=...
GEMINI_MODEL=imagen-4.0-generate-001

# ── Grsai ───────────────────────────────────────────────
GRSAI_API_KEY=sk-...
GRSAI_BASE_URL=https://grsai.dakka.com.cn
GRSAI_IMAGE_MODEL=gpt-image-2-vip

# ── ComfyUI 本地 ────────────────────────────────────────
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKFLOW_ID=<文生图 workflow UUID>

# ── RunningHub ──────────────────────────────────────────
RUNNINGHUB_API_KEY=rh-...
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_IMAGE_WORKFLOW_ID=<文生图 workflow ID>
RUNNINGHUB_VIDEO_WORKFLOW_ID=<LTX 视频 workflow ID>
RUNNINGHUB_DUB_WORKFLOW_ID=<TTS 配音 workflow ID>
RUNNINGHUB_UPSCALE_WORKFLOW_ID=<多宫格高清放大裁切 workflow ID>
RUNNINGHUB_VOICE_DESIGN_WORKFLOW_ID=<音色设计 workflow ID>
RUNNINGHUB_DUB_CLONE_WORKFLOW_ID=<克隆配音 workflow ID>
RUNNINGHUB_MAX_PARALLEL=3     # RunningHub 任务并发数（每个任务 create+poll 阻塞，独立任务可并发跑）

# ── Provider 容灾（按角色分离，可选） ──────────────────────────
# 锚图（角色/场景/道具）和分镜首帧可分别指定主/备 provider
# 留空则沿用 IMAGE_PROVIDER 的值
IMAGE_PROVIDER_ANCHOR=
IMAGE_PROVIDER_ANCHOR_FALLBACK=gemini
IMAGE_PROVIDER_SHOT=
IMAGE_PROVIDER_SHOT_FALLBACK=gemini

# ── 宫格拆分 ─────────────────────────────────────────────
GRID_TARGET_ASPECT=9:16
GRID_UPSCALE_SHOTS_THRESHOLD=2
GRID_CANVAS_MODE=economy      # economy | precise
GRID_IMAGE_MODEL=gpt-image-2

# ── 生成参数 ─────────────────────────────────────────────
IMAGE_WIDTH=768
IMAGE_HEIGHT=1344
POLL_INTERVAL_S=5
POLL_TIMEOUT_S=300
